# LOOPKEEPER Environment Configuration Example
# Copy to .env and configure credentials.

# --- Crusoe Cloud Managed Inference ---
CRUSOE_API_KEY=
MODEL_BASE_URL=https://api.inference.crusoecloud.com/v1
MODEL_NAME=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_API_PROTOCOL=openai-compatible
INTELLIGENCE_PROVIDER=crusoe

# ==============================================================================
# LOOPKEEPER DUAL-NEON DATABASE ARCHITECTURE
# ==============================================================================
# 1. CONTROL & AGENT INTELLIGENCE PLANE (Project: loopkeeper-control)
#    - Facility topology, robot fleet registry, missions, incidents, control leases,
#      traffic reservations, operator commands, LangGraph agent checkpointer.
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxxxxxxx.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:PASSWORD@ep-xxxxxxxx.region.aws.neon.tech/neondb?sslmode=require"

# 2. TELEMETRY LAKE & EVENT HISTORIAN (Project: loopkeeper-telemetry)
#    - High-throughput sensor_samples (1.2M+ rows), world_snapshots, event ledger,
#      time-travel scrubbing, rolling window compaction.
TELEMETRY_DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxxxxxxx.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
TELEMETRY_DATABASE_URL_UNPOOLED="postgresql://neondb_owner:PASSWORD@ep-xxxxxxxx.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# 3. DISPOSABLE SCRATCH TEST BRANCH (Branch: test-scratch on loopkeeper-control)
#    - Used by test suites (test_v6_persistence, test_policy_seams) for zero-risk DB tests.
TEST_DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxxxxxxx.region.aws.neon.tech/neondb?sslmode=require"

NEON_BRANCH=production
LOOPKEEPER_AUTH_DISABLED=1

# --- Simulation Engine ---
WORLD_SEED=1337
SIM_TICK_S=1.0
SIM_SPEED_MULTIPLIER=1
SAFE_AUTOMATION_MODE=supervised

# --- Authoritative API ---
API_HOST=127.0.0.1
API_PORT=8787
API_AUTH_DISABLED=true
API_AUTH_TOKEN=
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5183,https://your-app.vercel.app

# --- Crusoe model tiers (measured on this account; thinking off = ~0.9 s Nano / ~1.8 s Super) ---
# MODEL_NAME serves frequent perception/classification calls; MODEL_NAME_DEEP serves reconcile/intervention/replan/verify/escalate and scenario authoring.
MODEL_NAME_DEEP=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
MODEL_SEED=7
MODEL_THINKING=0
MODEL_THINKING_DEEP=0
