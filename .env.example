# LOOPKEEPER / Crusoe Cooler System — copy to .env and fill in. Never commit .env.

# --- Crusoe Managed Inference (server-side only) ---
CRUSOE_API_KEY=
MODEL_BASE_URL=https://api.inference.crusoecloud.com/v1
MODEL_NAME=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B          # frequent perception / classification decisions
MODEL_NAME_DEEP=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B  # reconcile / intervention / replan / verify / escalate
MODEL_SEED=7
MODEL_THINKING=0
MODEL_THINKING_DEEP=0

# --- PostgreSQL (optional; in-memory if empty). Pooled URL for the API, direct URL for migrations + checkpoints ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- API ---
API_HOST=127.0.0.1
API_PORT=8787
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_AUTH_TOKEN=
API_AUTH_DISABLED=false     # true only on a trusted local machine

# --- Simulation ---
WORLD_SEED=1337
SIM_SPEED_MULTIPLIER=1
SAFE_AUTOMATION_MODE=supervised

# --- Web (build time; only VITE_* reaches the browser) ---
# VITE_API_URL=http://localhost:8787
# VITE_DEFAULT_API_URL=   # optional default backend URL for hosted builds; empty = the UI asks
